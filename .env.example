# Optional: replace with a browser-accessible MapLibre street, terrain, or satellite style URL.
# NEXT_PUBLIC_BASEMAP_STYLE_URL=https://your-provider.example/styles/your-style.json

# Optional cloud accounts and private map sync.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Cloudflare R2 S3 credentials. Never prefix these with NEXT_PUBLIC_.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=field-atlas-maps

# Server-only secret used to rate-limit anonymous reports without storing raw IP addresses.
# Generate a long random value (for example, at least 32 random bytes).
# REPORT_FINGERPRINT_SECRET=replace-with-a-long-random-secret
